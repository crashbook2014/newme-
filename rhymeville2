        .timeline-dot.active, .timeline-dot:hover {
            border-color: #A78B6D;
            transform: scale(1.1);
        }
        .timeline-dot.active .inner-dot {
            opacity: 1;
        }
        .inner-dot {
            width: 12px;
            height: 12px;
            background-color: #A78B6D;
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }
        .fade-in.is-visible {
            opacity: 1;
