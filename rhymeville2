            padding-right: 0;
        }
        .timeline-item:not(:last-child)::before {
            content: '';
            position: absolute;
            top: 12px;
            right: 11px;
            width: 2px;
            height: 100%;
            background-color: #E0E0E0;
        }
        [lang="en"] .timeline-item:not(:last-child)::before {
            right: auto;
            left: 11px;
        }
        .timeline-dot {
            position: absolute;
            top: 0;
            right: 0;
            width: 24px;
            height: 24px;
            background-color: #F7F2EB;
            border: 2px solid #E0E0E0;
            border-radius: 50%;
