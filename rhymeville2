    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            const langToggleButton = document.getElementById('lang-toggle-button');
            const appContainer = document.getElementById('app-container');
            const arContent = document.querySelector('[lang="ar"]');
            const enContent = document.querySelector('[lang="en"]');
            const langTextAr = document.getElementById('lang-text-ar');
            const langTextEn = document.getElementById('lang-text-en');

            const toggleLanguage = () => {
                const isEnglish = enContent.classList.contains('hidden');
                
                if (isEnglish) {
                    // Switch to English
                    arContent.classList.add('hidden');
                    enContent.classList.remove('hidden');
                    document.documentElement.setAttribute('lang', 'en');
                    document.documentElement.setAttribute('dir', 'ltr');
                    langTextAr.classList.add('hidden');
                    langTextEn.classList.remove('hidden');
                } else {
                    // Switch to Arabic
                    arContent.classList.remove('hidden');
                    enContent.classList.add('hidden');
                    document.documentElement.setAttribute('lang', 'ar');
                    document.documentElement.setAttribute('dir', 'rtl');
                    langTextAr.classList.remove('hidden');
                    langTextEn.classList.add('hidden');
                }

                // Re-render charts on language change to update font
                if (window.revenueStreamsChartAr) window.revenueStreamsChartAr.destroy();
                if (window.revenueStreamsChartEn) window.revenueStreamsChartEn.destroy();
                if (window.revenueProjectionChartAr) window.revenueProjectionChartAr.destroy();
                if (window.revenueProjectionChartEn) window.revenueProjectionChartEn.destroy();
                if (window.investmentChartAr) window.investmentChartAr.destroy();
                if (window.investmentChartEn) window.investmentChartEn.destroy();
                initCharts();
            };

            langToggleButton.addEventListener('click', toggleLanguage);
            
            // --- Mobile Menu Toggle ---
            const mobileMenuButtonAr = document.getElementById('mobile-menu-button-ar');
            const mobileMenuAr = document.getElementById('mobile-menu-ar');
            mobileMenuButtonAr.addEventListener('click', () => { mobileMenuAr.classList.toggle('hidden'); });

            const mobileMenuButtonEn = document.getElementById('mobile-menu-button-en');
            const mobileMenuEn = document.getElementById('mobile-menu-en');
            mobileMenuButtonEn.addEventListener('click', () => { mobileMenuEn.classList.toggle('hidden'); });

            // --- Navigation Highlighting ---
            const setActiveNavLink = (sectionId, lang) => {
                document.querySelectorAll(`[lang="${lang}"] .nav-link`).forEach(link => {
                    link.classList.remove('active');
                    if (link.getAttribute('href').substring(1) === sectionId) {
                        link.classList.add('active');
                    }
                });
            };

            const observerOptions = { root: null, rootMargin: '0px', threshold: 0.4 };
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const lang = entry.target.closest('.content-container').getAttribute('lang');
                        setActiveNavLink(entry.target.id, lang);
                    }
                });
            }, observerOptions);

            document.querySelectorAll('section').forEach(section => { observer.observe(section); });

            // --- Counter Animation ---
            function animateCounter(el) {
                const target = +el.getAttribute('data-target');
                let count = 0;
                const duration = 2000;
                const stepTime = Math.abs(Math.floor(duration / target));
                const timer = setInterval(() => {
                    count++;
                    el.innerText = count;
                    if (count === target) { clearInterval(timer); }
                }, stepTime);
            }

            const counterObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        animateCounter(entry.target);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.8 });

            document.querySelectorAll('.counter').forEach(counter => { counterObserver.observe(counter); });

            // --- Fade-in on scroll effect ---
            const fadeElements = document.querySelectorAll('.fade-in');
            const fadeInObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.3 });
            fadeElements.forEach(el => fadeInObserver.observe(el));

            // --- Chart.js Configuration ---
            const initCharts = () => {
                if (document.documentElement.lang === 'en') {
                    Chart.defaults.font.family = 'Playfair Display';
                } else {
                    Chart.defaults.font.family = 'Tajawal';
                }

                const revenueStreamsCtxAr = document.getElementById('revenueStreamsChartAr')?.getContext('2d');
                if (revenueStreamsCtxAr) {
                    window.revenueStreamsChartAr = new Chart(revenueStreamsCtxAr, {
                        type: 'doughnut',
                        data: {
                            labels: ['إيرادات العقود (شركات)', 'إيرادات التجزئة (أفراد)', 'الخدمات المضافة'],
                            datasets: [{
                                label: 'مصادر الدخل',
                                data: [70, 20, 10],
                                backgroundColor: ['#4B2C1C', '#A78B6D', '#EBD8C9'],
                                borderColor: '#F7F2EB',
                                borderWidth: 4
                            }]
                        },
                        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: (context) => `${context.label}: ${context.raw}%` } } } }
                    });
                }

                const revenueProjectionCtxAr = document.getElementById('revenueProjectionChartAr')?.getContext('2d');
                if(revenueProjectionCtxAr) {
                    window.revenueProjectionChartAr = new Chart(revenueProjectionCtxAr, {
                        type: 'bar',
                        data: {
                            labels: ['الإيرادات المتوقعة سنوياً'],
                            datasets: [{
                                label: 'إيرادات أساسية',
                                data: [2880000],
                                backgroundColor: '#4B2C1C',
                                borderRadius: 5
                            }, {
                                label: 'مع الخدمات المضافة',
                                data: [3500000],
                                backgroundColor: '#A78B6D',
                                borderRadius: 5
                            }]
                        },
                        options: {
                            responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { callback: (value) => (value / 1000000) + ' مليون ريال' } } },
                            plugins: { tooltip: { callbacks: { label: (context) => `${context.dataset.label}: ${new Intl.NumberFormat('ar-SA', { style: 'currency', currency: 'SAR' }).format(context.parsed.y)}` } } }
                        }
                    });
                }

                const investmentCtxAr = document.getElementById('investmentChartAr')?.getContext('2d');
                if (investmentCtxAr) {
                    window.investmentChartAr = new Chart(investmentCtxAr, {
                        type: 'doughnut',
                        data: {
                            labels: ['تجهيز وتأثيث الوحدات', 'التسويق والانتشار', 'التكاليف التشغيلية', 'احتياطي للطوارئ'],
                            datasets: [{
                                label: 'توزيع الاستثمار',
                                data: [50, 20, 20, 10],
                                backgroundColor: ['#4B2C1C', '#A78B6D', '#EBD8C9', '#BCAAA4'],
                                borderColor: '#F7F2EB',
                                borderWidth: 4
                            }]
                        },
                        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: (context) => `${context.label}: ${context.raw}%` } } } }
                    });
                }

                const revenueStreamsCtxEn = document.getElementById('revenueStreamsChartEn')?.getContext('2d');
                if (revenueStreamsCtxEn) {
                    window.revenueStreamsChartEn = new Chart(revenueStreamsCtxEn, {
                        type: 'doughnut',
                        data: {
                            labels: ['Corporate Contracts Revenue', 'Retail (Individual) Revenue', 'Added Services'],
                            datasets: [{
                                label: 'Revenue Streams',
                                data: [70, 20, 10],
                                backgroundColor: ['#4B2C1C', '#A78B6D', '#EBD8C9'],
                                borderColor: '#F7F2EB',
                                borderWidth: 4
                            }]
                        },
                        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: (context) => `${context.label}: ${context.raw}%` } } } }
                    });
                }

                const revenueProjectionCtxEn = document.getElementById('revenueProjectionChartEn')?.getContext('2d');
                if(revenueProjectionCtxEn) {
                    window.revenueProjectionChartEn = new Chart(revenueProjectionCtxEn, {
                        type: 'bar',
                        data: {
                            labels: ['Projected Annual Revenue'],
                            datasets: [{
                                label: 'Base Revenue',
                                data: [2880000],
                                backgroundColor: '#4B2C1C',
                                borderRadius: 5
                            }, {
                                label: 'With Added Services',
                                data: [3500000],
                                backgroundColor: '#A78B6D',
                                borderRadius: 5
                            }]
                        },
                        options: {
                            responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { callback: (value) => (value / 1000000) + ' M SAR' } } },
                            plugins: { tooltip: { callbacks: { label: (context) => `${context.dataset.label}: ${new Intl.NumberFormat('en-US', { style: 'currency', currency: 'SAR' }).format(context.parsed.y)}` } } }
                        }
                    });
                }

                const investmentCtxEn = document.getElementById('investmentChartEn')?.getContext('2d');
                if (investmentCtxEn) {
                    window.investmentChartEn = new Chart(investmentCtxEn, {
                        type: 'doughnut',
                        data: {
                            labels: ['Unit Furnishing & Prep', 'Marketing & Outreach', 'Operational Costs', 'Contingency Fund'],
                            datasets: [{
                                label: 'Investment Distribution',
                                data: [50, 20, 20, 10],
                                backgroundColor: ['#4B2C1C', '#A78B6D', '#EBD8C9', '#BCAAA4'],
                                borderColor: '#F7F2EB',
                                borderWidth: 4
                            }]
                        },
                        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: (context) => `${context.label}: ${context.raw}%` } } } }
                    });
                }
            };
            initCharts();

            // --- Roadmap functionality ---
            const roadmapDataAr = {
                '1': { title: 'السنة الأولى: الانطلاقة والتشغيل الكامل', description: 'بدء التشغيل الكامل للعقار الأول الذي يضم 20 وحدة سكنية، مع التركيز على بناء علاقات قوية مع الشركاء من الشركات وتحقيق الإيرادات المستهدفة.' },
                '2': { title: 'السنة الثانية: التوسع الأول', description: 'إضافة عقار ثانٍ لزيادة القدرة الاستيعابية، وتوسيع قاعدة العملاء من الشركات مع تطوير باقة الخدمات المضافة بناءً على ملاحظات العملاء.' },
                '3': { title: 'السنة الثالثة: النمو والنطاق الأوسع', description: 'إضافة عقار ثالث للوصول إلى 60-70 وحدة سكنية، وتوسيع نطاق العمليات ليشمل فعاليات أكبر وتنويع مصادر الدخل بشكل أكبر.' }
            };
            const roadmapDataEn = {
                '1': { title: 'Year One: Launch and Full Operation', description: 'Begin full operation of the first property, which includes 20 residential units, with a focus on building strong relationships with corporate partners and achieving target revenues.' },
                '2': { title: 'Year Two: First Expansion', description: 'Add a second property to increase capacity, and expand the corporate client base while developing the added services package based on customer feedback.' },
                '3': { title: 'Year Three: Growth & Wider Scale', description: 'Add a third property to reach 60-70 residential units, and expand the scope of operations to include larger events and further diversify revenue streams.' }
            };

            const updateRoadmap = (year, lang) => {
                const details = document.getElementById(`roadmap-details-${lang}`);
                const data = lang === 'ar' ? roadmapDataAr : roadmapDataEn;
                details.innerHTML = `<h3 class="text-xl font-bold text-[#A78B6D]">${data[year].title}</h3><p class="mt-2 text-gray-700">${data[year].description}</p>`;
            };

            document.querySelectorAll('.timeline-dot').forEach(dot => {
                dot.addEventListener('click', () => {
                    const year = dot.dataset.year;
                    const lang = dot.closest('.content-container').getAttribute('lang');
                    document.querySelectorAll(`[lang="${lang}"] .timeline-dot`).forEach(d => d.classList.remove('active'));
                    dot.classList.add('active');
                    updateRoadmap(year, lang);
                });
            });

        });
    </script>
